# Supabase
#
# Both values are baked into the built frontend — they are NOT secrets and
# must never be treated as such. Anyone can read them from the browser.
# RLS in the database is the only thing protecting the data:
#   supabase/migrations/JALANKAN-INI.sql
#
# Left unset, the app falls back to the values inlined in
# src/supabase/client.ts, which is why the build works with no .env at all.

VITE_SUPABASE_URL=https://ddfalsclevkqhiyojngx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Only for the Playwright suite. Refused by the app unless the page is served
# from localhost, so it cannot open up a real deployment.
# VITE_E2E_AUTH_BYPASS=1

# Itsfood supplier portal (server-side only — api/itsfood-*.ts on Vercel,
# the Vite dev middleware locally). NEVER prefixed with VITE_: these are
# scraping credentials and must never reach the browser bundle.
#
# The portal has no official API; these credentials let our server mirror
# the browser flow (login fresh per request). Set them in Vercel project
# env vars for production.
ITSFOOD_USERNAME=
ITSFOOD_PASSWORD=