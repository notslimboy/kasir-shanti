# 266 nama + alamat customer sungguhan. Parser membacanya sebagai
# referensi aktif, tapi isinya data pribadi orang. Bentuk kolomnya ada
# di `customers.csv.example`; file aslinya dibuat dengan:
#     python3 update_customers_csv.py
customers.csv
untagged-customers*.csv
backups/

# Chat WhatsApp mentah. Isinya percakapan pribadi customer, hundreds KB,
# dan hanya dipakai sebagai input lokal saat parsing — bukan bagian repo.
Chat*.txt
_chat*.txt
orderan/
scratch/

# Snapshot database lokal
*.sqlite3
*.db

