dist/
*.tsbuildinfo
.DS_Store

# Hasil emit `tsc -b` ke dalam src/ — artefak compiler, bukan source.
# Tanpa aturan ini file .js hasil build ikut hilang saat `git clean`.
src/**/*.js
src/**/*.d.ts
src/**/*.js.map

# screenshot debug — jangan di-commit
*.png
!design/reference.png
!public/*.png

# Artefak Playwright — trace kegagalan berisi snapshot seluruh DOM,
# termasuk data yang tampil di layar. Jangan masuk repo.
test-results/
playwright-report/
blob-report/
.playwright/

